---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionUser } from '@/lib/auth';
import { query } from '@/lib/db';

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect('/');

const saves = await query<{ slug: string; title: string; description: string }>(
  `SELECT r.slug, r.title, r.description
   FROM social.recipe_saves s
   JOIN content.recipes r ON r.id = s.recipe_id
   WHERE s.user_id = $1
   ORDER BY s.created_at DESC`,
  [user.id]
);
---
<BaseLayout title="Meine gespeicherten Rezepte">
  <h1 class="mb-4 text-2xl font-bold">Meine gespeicherten Rezepte</h1>
  <ul class="space-y-3">
    {saves.map((recipe) => (
      <li class="rounded bg-white p-4 shadow">
        <a href={`/recipes/${recipe.slug}`} class="font-semibold">{recipe.title}</a>
        <p class="text-sm">{recipe.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
