---
const { recipeId } = Astro.props;
---

<div class="mt-6 rounded-lg border border-orange-200 bg-white p-4" data-recipe-actions data-recipe-id={recipeId}>
  <p class="mb-2 text-sm text-slate-600">Aktionen (Login erforderlich)</p>
  <div class="flex gap-3">
    <button data-like class="rounded bg-pumpkin-500 px-3 py-2 text-white">Like</button>
    <button data-save class="rounded bg-slate-700 px-3 py-2 text-white">Speichern</button>
  </div>
  <p data-state class="mt-3 text-sm text-slate-600">Prüfe Status...</p>
</div>

<script>
  const root = document.querySelector('[data-recipe-actions]');
  if (root) {
    const recipeId = root.getAttribute('data-recipe-id');
    const likeButton = root.querySelector('[data-like]');
    const saveButton = root.querySelector('[data-save]');
    const state = root.querySelector('[data-state]');
    let csrfToken = '';

    const setState = (text) => {
      if (state) state.textContent = text;
    };

    const request = async (url, method) => {
      const response = await fetch(url, {
        method,
        headers: {
          'content-type': 'application/json',
          'x-csrf-token': csrfToken
        }
      });

      if (!response.ok) {
        const payload = await response.json().catch(() => ({ error: 'Fehler' }));
        throw new Error(payload.error || 'Fehler');
      }
    };

    const init = async () => {
      const auth = await fetch('/api/auth/me');
      const authData = await auth.json();
      csrfToken = authData.csrfToken;

      if (!authData.user) {
        setState('Bitte einloggen, um Likes/Saves zu verwenden.');
        likeButton?.setAttribute('disabled', 'true');
        saveButton?.setAttribute('disabled', 'true');
        return;
      }

      setState('Bereit.');
      likeButton?.addEventListener('click', async () => {
        try {
          await request(`/api/recipes/${recipeId}/like`, 'POST');
          setState('Rezept gelikt ✅');
        } catch (error) {
          setState(error.message);
        }
      });

      saveButton?.addEventListener('click', async () => {
        try {
          await request(`/api/recipes/${recipeId}/save`, 'POST');
          setState('Rezept gespeichert ✅');
        } catch (error) {
          setState(error.message);
        }
      });
    };

    init().catch(() => setState('Aktionen konnten nicht geladen werden.'));
  }
</script>
